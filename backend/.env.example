# ── Database ──
# PostgreSQL connection string (Neon, Supabase, Railway, or local Postgres)
DATABASE_URL="postgresql://user:password@host:5432/finai?sslmode=require"

# ── Auth ──
# REQUIRED in production. Generate a strong value, e.g.:  openssl rand -base64 48
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"
# bcrypt cost factor (higher = slower/safer). 12 is a good default.
BCRYPT_ROUNDS="12"

# ── AI ──
# Google Gemini API key — get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your-gemini-api-key"

# ── Server ──
PORT="4000"
# Comma-separated list of allowed origins, or * for any (dev only).
CORS_ORIGIN="http://localhost:3000"
# Set to "production" when deploying.
NODE_ENV="development"
